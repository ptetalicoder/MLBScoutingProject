# Copy to .env and fill in. .env is gitignored — never commit real values.

# SQLite (used by db.py, init_sqlite_db.py, and the data_import_*.py ETL
# scripts as of the Phase 1 demo build). Optional — defaults to
# ./mlb_scouting.db if unset.
SQLITE_DB_PATH=mlb_scouting.db

# MySQL connection (still used by player_crud.py and 07_mlb_assistant_app.py
# until those migrate to SQLite too)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=your-database

# Used by the SQL Chat and Scouting Assistant modules, and by rag_build_*.py
OPENAI_API_KEY=sk-...
