# Copy to .env and fill in. .env is gitignored — never commit real values.

# MySQL connection (the original setup; the demo build will move to SQLite)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=your-database

# Used by the SQL Chat and Scouting Assistant modules, and by rag_build_*.py
OPENAI_API_KEY=sk-...
